generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      Role     @default(CLIENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions OnboardingSession[]
}

model OnboardingSession {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String?
  status      SessionStatus @default(IN_PROGRESS)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fields FormField[]
}

model FormField {
  id        String   @id @default(cuid())
  sessionId String
  session   OnboardingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  sheetName String
  fieldKey  String
  fieldValue String?
  fieldType FieldType @default(TEXT)

  completed Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, sheetName, fieldKey])
  @@index([sessionId, sheetName])
}

enum Role {
  CLIENT
  INTERNAL
  ADMIN
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum FieldType {
  TEXT
  TEXTAREA
  SELECT
  MULTISELECT
  DATE
  NUMBER
  CHECKBOX
  EMAIL
  PHONE
  URL
}
